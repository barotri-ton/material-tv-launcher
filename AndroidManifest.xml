<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rampey.materialtv">

    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Online for the weather (on by default) and the optional screensaver photos. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The weather's place when no city is typed: the TV's own rough location, if it has one (granted by install.sh;
         most TVs have none, and the place is then guessed from the home's IP). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: only apps with a TV or phone launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
    </queries>

    <!-- Per-app screen time, read on the TV only, to order the dock by use (granted over ADB by install.sh). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- The optional Continue tab: what the TV's apps offer under Continue watching (Watch Next). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Now Playing on TVs that never allow notification access (low-RAM Android 9): read `dumpsys media_session`
         on the TV only (granted over ADB by install.sh). -->
    <uses-permission android:name="android.permission.DUMP" />

    <!-- The tile menu's Uninstall: opens Android's own confirmation for apps the user installed. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:label="Material TV Launcher"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/HomeTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets the home screen see which app is playing media (Now Playing card). Reads no notifications. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Now Playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The screensaver: clock, date, the drifting shape, colors that glide between Material palettes. -->
        <service
            android:name=".Screensaver"
            android:exported="true"
            android:label="Material TV Clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Sends the remote's Home button, and any return to Google TV's home screen, here. -->
        <service
            android:name=".HomeKeyService"
            android:exported="true"
            android:label="Home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
